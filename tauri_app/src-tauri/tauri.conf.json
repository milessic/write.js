{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Write.JS",
  "mainBinaryName": "writejs",
  "version": "0.1.0",
  "identifier": "com.milessic.writejs",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Create, edit and manage documents, also offline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../static/": "static/"
    }
  }
}